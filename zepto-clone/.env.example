# All optional. The app runs with no env vars at all.
PORT=3001
JWT_SECRET=change-me
# Razorpay TEST keys (dashboard.razorpay.com > Settings > API Keys, with "Test Mode" on).
# Leave empty to use the simulated payment flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Live tracking simulator: seconds spent in each stage (placed>packing, packing>on the way, on the way>delivered)
STEP_SECONDS=20,30,60
AUTO_PROGRESS=1
# Where the SQLite file lives (use a persistent disk path in production)
# DB_FILE=./server/zippy.db
