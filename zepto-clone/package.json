{
  "name": "zippy-quick-commerce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:server\" \"npm:web\"",
    "server": "node --watch server/index.js",
    "web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node server/test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "vite": "^5.4.0"
  },
  "description": "Zippy - a full-stack quick-commerce grocery app (React, Express, SQLite, Razorpay test mode, live order tracking)",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  }
